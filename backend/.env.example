# =============================================================================
# EPICO BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================
PORT=5000
NODE_ENV=development

# SMTP Email Dispatcher (Gmail, SendGrid, Resend, or Custom SMTP)
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=epicosportofficial@gmail.com
SMTP_PASS=your_gmail_app_password_here

# Destination inbox for incoming brand inquiries & visitor comments
RECIPIENT_EMAIL=epicosportofficial@gmail.com

